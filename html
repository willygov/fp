<script>
(function(){
  /* pixel mascot */
  var body=[
    "....kkkkkk....",
    "..kkggggggkk..",
    ".kggggggggggk.",
    ".kggggggggggk.",
    "kggggggggggggk",
    "kggggggggggggk",
    "kggggggggggggk",
    "kggggggggggggk",
    ".kggggggggggk.",
    ".kkkkkkkkkkkk."
  ];
  var pal={k:"#1d1a16",g:"#c6f432"};
  var NS="http://www.w3.org/2000/svg",svg=document.getElementById("mascot");
  function rect(x,y,w,h,f){var r=document.createElementNS(NS,"rect");r.setAttribute("x",x);r.setAttribute("y",y);r.setAttribute("width",w);r.setAttribute("height",h);r.setAttribute("fill",f);svg.appendChild(r);return r}
  body.forEach(function(row,y){for(var x=0;x<row.length;x++){var c=row[x];if(c!=="."){rect(x,y,1,1,pal[c])}}});
  rect(2,6,2,1,"#ff6b57");rect(10,6,2,1,"#ff6b57");rect(6,7,2,1,"#1d1a16");
  var eyes=[[4,3],[8,3]],pupils=[],lids=[];
  eyes.forEach(function(e){
    rect(e[0],e[1],2,2,"#ffffff");
    pupils.push(rect(e[0],e[1],1,1,"#1d1a16"));
    var l=rect(e[0],e[1],2,2,"#c6f432");l.style.display="none";lids.push(l);
  });
  function look(cx,cy){
    var b=svg.getBoundingClientRect(),mx=b.left+b.width/2,my=b.top+b.height*0.4;
    var dx=cx>mx+12?1:0,dy=cy>my+12?1:0;
    pupils.forEach(function(p,i){p.setAttribute("x",eyes[i][0]+dx);p.setAttribute("y",eyes[i][1]+dy)});
  }
  addEventListener("pointermove",function(e){look(e.clientX,e.clientY)},{passive:true});
  function blink(){
    lids.forEach(function(l){l.style.display=""});
    setTimeout(function(){lids.forEach(function(l){l.style.display="none"})},140);
    setTimeout(blink,2200+Math.random()*2800);
  }
  setTimeout(blink,2000);
  var lines=["Psst. Do your own research.","Never trade money you need.","Check the address says fomo.family.","Hi! Tap me again.","Take a look around first."],n=0,bub=document.getElementById("bubble");
  function poke(){
    svg.classList.remove("hop");void svg.getBoundingClientRect();svg.classList.add("hop");
    n=(n+1)%lines.length;bub.textContent=lines[n];
  }
  svg.addEventListener("click",poke);
  svg.addEventListener("keydown",function(e){if(e.key==="Enter"||e.key===" "){e.preventDefault();poke()}});

  /* copy field */
  var btn=document.getElementById("copy"),lab=document.getElementById("copyLabel"),u="https://fomo.family/r/willygov",tm;
  function done(m){btn.classList.add("done");lab.textContent=m;clearTimeout(tm);tm=setTimeout(function(){btn.classList.remove("done");lab.textContent="Copy"},1800)}
  btn.addEventListener("click",function(){
    if(navigator.clipboard&&navigator.clipboard.writeText){
      navigator.clipboard.writeText(u).then(function(){done("Copied")},function(){done("Select")});
    }else{
      var r=document.createRange();r.selectNodeContents(document.getElementById("ref"));
      var s=getSelection();s.removeAllRanges();s.addRange(r);done("Select");
    }
  });

  /* risk simulator */
  var amt=document.getElementById("amt"),drop=document.getElementById("drop");
  function money(n){return "$"+n.toLocaleString("en-US",{maximumFractionDigits:2})}
  function sim(){
    var a=Math.max(0,parseFloat(amt.value)||0),d=+drop.value,left=a*(1-d/100);
    document.getElementById("dropv").textContent=d+"%";
    document.getElementById("left").textContent=money(left);
    document.getElementById("loss").textContent=money(a-left);
    document.getElementById("need").textContent=d>=100?"Not possible":"+"+(d/(100-d)*100).toLocaleString("en-US",{maximumFractionDigits:0})+"%";
    document.getElementById("bar").style.width=(100-d)+"%";
  }
  amt.addEventListener("input",sim);drop.addEventListener("input",sim);sim();

  /* checklist */
  var boxes=[].slice.call(document.querySelectorAll(".check input")),pt=document.getElementById("ptext"),pb=document.getElementById("pbar");
  function prog(){
    var c=boxes.filter(function(b){return b.checked}).length;
    pb.style.width=(c/boxes.length*100)+"%";
    pt.textContent=c===boxes.length?"All set. Start small and stay curious.":c+" of "+boxes.length+" done";
  }
  boxes.forEach(function(b){b.addEventListener("change",prog)});prog();

  /* share */
  var sh=document.getElementById("share");
  sh.addEventListener("click",function(){
    var data={title:document.title,text:"Social-first crypto trading app. Read the risks first.",url:location.href};
    if(navigator.share){navigator.share(data).catch(function(){})}
    else if(navigator.clipboard&&navigator.clipboard.writeText){
      navigator.clipboard.writeText(location.href).then(function(){sh.textContent="Page link copied";setTimeout(function(){sh.textContent="Share this page"},1800)});
    }
  });


  /* smooth FAQ open and close */
  var reduce=window.matchMedia&&matchMedia("(prefers-reduced-motion: reduce)").matches;
  [].slice.call(document.querySelectorAll("details")).forEach(function(d){
    var sum=d.querySelector("summary"),body=d.querySelector("p"),anim=null;
    sum.addEventListener("click",function(e){
      e.preventDefault();
      if(reduce||!d.animate){d.open=!d.open;d.classList.toggle("is-open",d.open);return}
      var h0=d.getBoundingClientRect().height;
      if(anim){anim.cancel();anim=null}
      var opening=!d.classList.contains("is-open"),end;
      d.style.overflow="hidden";
      if(opening){
        d.open=true;d.classList.add("is-open");
        end=d.getBoundingClientRect().height;
        if(body)body.animate([{opacity:0,transform:"translateY(-8px)"},{opacity:1,transform:"none"}],{duration:320,delay:80,easing:"ease-out",fill:"backwards"});
      }else{
        d.classList.remove("is-open");
        var cs=getComputedStyle(d);
        end=sum.getBoundingClientRect().height+parseFloat(cs.borderTopWidth)+parseFloat(cs.borderBottomWidth);
      }
      anim=d.animate([{height:h0+"px"},{height:end+"px"}],{duration:340,easing:"cubic-bezier(.3,.9,.3,1)"});
      anim.onfinish=function(){if(!opening)d.open=false;d.style.overflow="";anim=null};
    });
  });

  /* hide sticky bar while the join section is visible */
  var bar=document.querySelector(".bar"),jn=document.getElementById("join");
  if("IntersectionObserver" in window){
    new IntersectionObserver(function(es){bar.classList.toggle("hide",es[0].isIntersecting)},{threshold:.25}).observe(jn);
  }
})();
</script>
