<style>
:root{
  --bg:#f3eee3; --panel:#fffaf0; --ink:#1d1a16; --muted:#6a6356; --line:#d9d1bf;
  --lime:#c6f432; --coral:#ff6b57; --lilac:#cdbdff;
  --accent:#1d1a16; --accent-ink:#f3eee3;
  --head:"Bricolage Grotesque","Segoe UI",system-ui,sans-serif;
  --pix:"Pixelify Sans","Courier New",monospace;
  color-scheme:light dark;
}
@media (prefers-color-scheme:dark){
  :root{
    --bg:#16140f; --panel:#201d16; --ink:#f3eee3; --muted:#a79f8d; --line:#35312a;
    --accent:#c6f432; --accent-ink:#16140f;
  }
}
*{box-sizing:border-box;margin:0;-webkit-tap-highlight-color:transparent}
a,button,summary,#mascot,.sticker,.card{-webkit-touch-callout:none;-webkit-user-select:none;user-select:none}
:focus:not(:focus-visible){outline:none}
::selection{background:var(--lime);color:#1d1a16}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{
  background:var(--bg);color:var(--ink);font:400 1rem/1.6 var(--head);
  padding:env(safe-area-inset-top) 0 calc(env(safe-area-inset-bottom) + 84px);overflow-x:hidden;
}
a{color:inherit}
:focus-visible{outline:3px solid var(--coral);outline-offset:3px;border-radius:6px}
.wrap{width:min(100% - 40px,1000px);margin-inline:auto}
.pix{font-family:var(--pix)}

/* header */
.top{padding:20px 0}
.top .wrap{display:flex;justify-content:space-between;align-items:center;gap:12px}
.mark{font:700 1.15rem var(--pix);letter-spacing:.01em}
.mark i{font-style:normal;background:var(--lime);color:#1d1a16;padding:0 6px;border-radius:4px;margin-left:2px}
.xlink{display:inline-flex;align-items:center;gap:8px;text-decoration:none;font-weight:500;font-size:.92rem;
  padding:8px 14px;border:2px solid var(--ink);border-radius:999px;background:var(--panel);transition:transform .15s}
.xlink:hover{transform:translateY(-2px) rotate(-1deg)}
.xlink svg{width:14px;height:14px;fill:currentColor}

/* hero */
.hero{padding:24px 0 64px}
.hero .wrap{display:grid;gap:40px;align-items:center}
h1{font:800 clamp(2.2rem,9vw,4.2rem)/1.02 var(--head);letter-spacing:-.04em}
h1 mark{background:var(--lime);color:#1d1a16;padding:0 .12em;border-radius:.14em;box-decoration-break:clone;-webkit-box-decoration-break:clone}
.lead{margin-top:20px;max-width:44ch;color:var(--muted);font-size:1.1rem}
.cta-row{margin-top:28px;display:flex;flex-wrap:wrap;gap:12px}
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:0 24px;
  border:2px solid var(--ink);border-radius:14px;background:var(--accent);color:var(--accent-ink);
  font:700 1rem var(--head);text-decoration:none;cursor:pointer;
  box-shadow:4px 4px 0 var(--coral);transition:transform .12s,box-shadow .12s;
}
.btn:hover{transform:translate(-2px,-2px);box-shadow:6px 6px 0 var(--coral)}
.btn:active{transform:translate(3px,3px);box-shadow:1px 1px 0 var(--coral)}
.btn.ghost{background:var(--panel);color:var(--ink);box-shadow:4px 4px 0 var(--ink)}
.btn.ghost:hover{box-shadow:6px 6px 0 var(--ink)}
.btn.ghost:active{box-shadow:1px 1px 0 var(--ink)}
.btn svg{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
.fine{margin-top:16px;font-size:.85rem;color:var(--muted);max-width:50ch}

/* stage with mascot */
.stage{
  position:relative;background:var(--panel);border:2px solid var(--ink);border-radius:28px;
  padding:48px 24px 28px;display:grid;place-items:center;overflow:hidden;
  background-image:radial-gradient(var(--line) 1.5px,transparent 1.5px);background-size:18px 18px;
}
.bubble{
  position:relative;font:500 .95rem var(--pix);background:var(--bg);border:2px solid var(--ink);border-radius:12px;
  padding:8px 14px;margin-bottom:18px;max-width:90%;text-align:center
}
.bubble::after{content:"";position:absolute;left:50%;bottom:-9px;width:14px;height:14px;background:var(--bg);
  border-right:2px solid var(--ink);border-bottom:2px solid var(--ink);transform:translateX(-50%) rotate(45deg)}
#mascot{width:min(62%,230px);height:auto;cursor:pointer;image-rendering:pixelated;touch-action:manipulation;
  filter:drop-shadow(0 8px 0 rgba(0,0,0,.12))}
#mascot.hop{animation:hop .45s ease-out}
@keyframes hop{0%{transform:translateY(0)}40%{transform:translateY(-26px) scaleY(1.06)}70%{transform:translateY(0) scaleY(.92)}100%{transform:none}}
.floor{width:62%;max-width:230px;height:8px;margin-top:6px;border-radius:50%;background:rgba(0,0,0,.14);filter:blur(1px)}
.sticker{
  position:absolute;right:14px;top:14px;transform:rotate(8deg);transition:transform .25s cubic-bezier(.3,1.6,.5,1);
  background:var(--lilac);color:#1d1a16;border:3px solid #fff;border-radius:16px;padding:8px 12px;
  font:700 .8rem/1.15 var(--pix);box-shadow:0 0 0 2px #1d1a16,3px 4px 0 2px rgba(0,0,0,.25);text-align:center;cursor:default
}
.sticker:hover{transform:rotate(-4deg) scale(1.08) translateY(-3px)}
.sticker b{display:block;font-size:1rem}

/* sections */
section{padding:64px 0;border-top:2px solid var(--ink)}
h2{font:800 clamp(1.6rem,5.4vw,2.4rem)/1.08 var(--head);letter-spacing:-.035em;max-width:18ch}
.sub{margin-top:12px;color:var(--muted);max-width:52ch}

.cards{margin-top:32px;display:grid;gap:18px}
.card{
  background:var(--panel);border:2px solid var(--ink);border-radius:20px;padding:22px;
  box-shadow:5px 5px 0 var(--ink);transition:transform .18s,box-shadow .18s;
}
.card:nth-child(1):hover{transform:rotate(-1.2deg) translateY(-4px)}
.card:nth-child(2):hover{transform:rotate(.9deg) translateY(-4px)}
.card:nth-child(3):hover{transform:rotate(-.7deg) translateY(-4px)}
.card:hover{box-shadow:8px 9px 0 var(--ink)}
.chip{display:inline-block;font:700 .8rem var(--pix);padding:3px 10px;border-radius:999px;border:2px solid var(--ink);margin-bottom:14px}
.card:nth-child(1) .chip{background:var(--lime);color:#1d1a16}
.card:nth-child(2) .chip{background:var(--coral);color:#1d1a16}
.card:nth-child(3) .chip{background:var(--lilac);color:#1d1a16}
.card h3{font:700 1.25rem/1.2 var(--head);letter-spacing:-.02em}
.card p{margin-top:8px;color:var(--muted)}

.feat{margin-top:32px;display:grid;gap:0;border-top:2px solid var(--ink)}
.feat div{display:grid;grid-template-columns:20px 1fr;gap:14px;padding:18px 0;border-bottom:1px solid var(--line)}
.feat i{width:14px;height:14px;margin-top:7px;background:var(--coral);box-shadow:3px 3px 0 var(--ink)}
.feat div:nth-child(2) i{background:var(--lime)}
.feat div:nth-child(3) i{background:var(--lilac)}
.feat b{display:block;font-size:1.1rem}
.feat span{color:var(--muted);max-width:52ch;display:block}

.risk{background:var(--coral);color:#1d1a16;border:2px solid var(--ink);border-radius:24px;padding:28px 22px;box-shadow:6px 6px 0 var(--ink)}
.risk h2{max-width:none;font-size:1.6rem}
.risk ul{margin:14px 0 0 1.1em;padding:0;display:grid;gap:8px;font-weight:500}

.copyrow{margin-top:28px;display:flex;flex-wrap:wrap;gap:12px}
.field{
  flex:1 1 260px;min-height:54px;display:flex;align-items:center;gap:10px;padding:0 8px 0 16px;
  background:var(--panel);border:2px solid var(--ink);border-radius:14px;box-shadow:4px 4px 0 var(--ink)
}
.field code{flex:1;font:500 .95rem var(--pix);overflow-wrap:anywhere;padding:6px 0}
.copy{
  min-height:40px;min-width:92px;padding:0 14px;border:2px solid var(--ink);border-radius:10px;background:var(--lime);color:#1d1a16;
  font:700 .88rem var(--head);cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:6px;transition:background .2s,transform .12s
}
.copy:active{transform:scale(.95)}
.copy svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}
.copy .ok{display:none}
.copy.done{background:#fff}
.copy.done .ok{display:block}.copy.done .cp{display:none}

details{border-bottom:2px solid var(--ink)}
details:first-of-type{margin-top:36px;border-top:2px solid var(--ink)}
summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;gap:16px;align-items:center;padding:18px 0;min-height:56px;font-weight:700;font-size:1.05rem}
summary::-webkit-details-marker{display:none}
summary::after{content:"+";display:grid;place-items:center;width:30px;height:30px;border:2px solid var(--ink);border-radius:8px;background:var(--lime);color:#1d1a16;font:700 1.2rem/1 var(--pix);flex:none;transition:transform .25s}
details.is-open summary::after{transform:rotate(135deg);background:var(--coral)}
details p{padding:0 0 18px;color:var(--muted);max-width:58ch}

footer{padding:28px 0 8px;border-top:2px solid var(--ink);font-size:.84rem;color:var(--muted)}
footer p+p{margin-top:6px}

.bar{
  position:fixed;inset:auto 0 0 0;z-index:20;display:flex;gap:12px;align-items:center;justify-content:space-between;
  padding:10px 20px calc(10px + env(safe-area-inset-bottom));
  background:color-mix(in srgb,var(--bg) 92%,transparent);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
  border-top:2px solid var(--ink)
}
.bar p{font-weight:700;font-size:.9rem;line-height:1.25}
.bar p small{display:block;font:400 .78rem var(--pix);color:var(--muted)}
.bar .btn{min-height:44px;padding:0 20px;flex:none}


/* simulator */
.sim{margin-top:28px;background:var(--panel);border:2px solid var(--ink);border-radius:20px;padding:22px;box-shadow:5px 5px 0 var(--ink);display:grid;gap:20px}
.sim label{font-weight:700;display:flex;justify-content:space-between;gap:12px;margin-bottom:8px}
.sim label span{font-family:var(--pix);color:var(--coral)}
.sim input[type=number]{width:100%;min-height:50px;border:2px solid var(--ink);border-radius:12px;background:var(--bg);color:var(--ink);font:700 1.15rem var(--pix);padding:0 14px}
.sim input[type=range]{width:100%;height:32px;accent-color:var(--coral);cursor:pointer}
.meter{height:22px;border:2px solid var(--ink);border-radius:11px;overflow:hidden;background:var(--coral)}
.meter i{display:block;height:100%;width:50%;background:var(--lime);transition:width .2s}
.out{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.out div{border:2px solid var(--ink);border-radius:14px;padding:12px 14px;background:var(--bg)}
.out small{display:block;color:var(--muted);font-size:.8rem;line-height:1.3}
.out b{font:700 1.35rem var(--pix);overflow-wrap:anywhere}
.out .wide{grid-column:1/-1}
.note{font-size:.82rem;color:var(--muted)}

/* checklist */
.check{margin-top:28px;display:grid;gap:10px}
.check label{display:grid;grid-template-columns:28px 1fr;gap:14px;align-items:center;padding:14px 16px;border:2px solid var(--ink);border-radius:14px;background:var(--panel);cursor:pointer;min-height:56px;transition:transform .15s}
.check label:active{transform:scale(.99)}
.check input{-webkit-appearance:none;appearance:none;width:28px;height:28px;border:2px solid var(--ink);border-radius:8px;background:var(--bg);margin:0;display:grid;place-content:center;cursor:pointer}
.check input::after{content:"";width:13px;height:7px;border-left:3px solid #1d1a16;border-bottom:3px solid #1d1a16;transform:rotate(-45deg) scale(0);transition:transform .15s;margin-top:-3px}
.check input:checked{background:var(--lime)}
.check input:checked::after{transform:rotate(-45deg) scale(1)}
.prog{margin-top:20px;display:grid;gap:8px}
.prog .meter{background:var(--panel)}
.prog .meter i{width:0}
.prog p{font:500 .95rem var(--pix)}

.bar{transition:transform .25s}
.bar.hide{transform:translateY(110%)}

@media (min-width:860px){
  .hero{padding:56px 0 96px}
  .hero .wrap{grid-template-columns:1.1fr .9fr;gap:64px}
  .cards{grid-template-columns:repeat(3,1fr)}
  .stage{padding:56px 32px 36px}
  .bar{justify-content:center;gap:32px}
}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *{transition:none!important;animation:none!important}
}
</style>
